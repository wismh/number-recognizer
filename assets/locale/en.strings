[[string]]
id = "help.softmax.a9"
text = "Not exactly. A model can be confidently wrong, especially on pictures unlike its training data, such as an empty canvas or a scribble. The number says how the model shares its confidence among the ten digits, not how often it is right."

[[string]]
id = "help.softmax.fig2"
text = "The same picture: scores on the left, probabilities after softmax on the right. The ranking stays, but the gaps grow."

[[string]]
id = "help.softmax.kicker"
text = "TOPIC 6"

[[string]]
id = "help.softmax.legend4"
text = "the probability the model gives to digit k."

[[string]]
id = "help.softmax.legend5"
text = "the score of digit k."

[[string]]
id = "help.softmax.legend6"
text = "Euler's number, about 2.718."

[[string]]
id = "help.softmax.note7"
text = "Example for three scores 2, 1 and 0: the exponentials are 7.39, 2.72 and 1, their sum is 11.11, so"

[[string]]
id = "help.softmax.p1"
text = "Scores are hard to interpret: they can be any numbers, negative or huge. Softmax turns the ten scores into ten probabilities that are positive and add up to 1."

[[string]]
id = "help.softmax.p3"
text = "The exponential e^s makes every number positive and magnifies differences: a slightly higher score becomes a much larger share. Dividing by the sum makes the shares add up to 1. The bars under Class Probabilities are these p_k."

[[string]]
id = "help.softmax.q8"
text = "Is 70% really a 70% chance?"

[[string]]
id = "help.softmax.title"
text = "Softmax: from scores to probabilities"

