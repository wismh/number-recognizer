[[string]]
id = "help.section.training"
text = "III. НАВЧАННЯ"

[[string]]
id = "help.softmax.a9"
text = "Не зовсім. Модель може бути впевнено неправа, особливо на зображеннях, несхожих на навчальні, наприклад на порожньому полотні чи каракулях. Число показує, як модель розподіляє впевненість між десятьма цифрами, а не як часто вона права."

[[string]]
id = "help.softmax.fig2"
text = "Те саме зображення: оцінки ліворуч, імовірності після softmax праворуч. Порядок лишається, але відстані зростають."

[[string]]
id = "help.softmax.kicker"
text = "ТЕМА 6"

[[string]]
id = "help.softmax.legend4"
text = "імовірність, яку модель дає цифрі k."

[[string]]
id = "help.softmax.legend5"
text = "оцінка цифри k."

[[string]]
id = "help.softmax.legend6"
text = "число Ейлера, приблизно 2,718."

[[string]]
id = "help.softmax.note7"
text = "Приклад для трьох оцінок 2, 1 і 0: експоненти 7,39, 2,72 і 1, їхня сума 11,11, отже"

[[string]]
id = "help.softmax.p1"
text = "Оцінки важко інтерпретувати: це можуть бути будь-які числа, від'ємні чи величезні. Softmax перетворює десять оцінок на десять імовірностей, які додатні й у сумі дають 1."

[[string]]
id = "help.softmax.p3"
text = "Експонента e^s робить кожне число додатним і збільшує різницю: трохи вища оцінка стає значно більшою часткою. Ділення на суму робить так, що частки в сумі дають 1. Смуги під заголовком імовірностей класів це ці p_k."

[[string]]
id = "help.softmax.q8"
