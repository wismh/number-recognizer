<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.augment.kicker}"/>
    <Label class="h-title" text="{tr help.augment.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.augment.p1}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-190" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.augment.fig2}"/>
    </Stack>
    <Label class="h-p" text="{tr help.augment.p3}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="0.7 \leq s \leq 1.4"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="s"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.augment.legend4}"/>
        </Stack>
    </Stack>
    <Label class="h-p" text="{tr help.augment.p5}"/>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.augment.note6}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.augment.q7}"/>
            <Label class="h-a" text="{tr help.augment.a8}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.augment.try}" command="{binding tryIt}"/>
</Stack>
