<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.batches.kicker}"/>
    <Label class="h-title" text="{tr help.batches.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.batches.p1}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="w \leftarrow w - \eta \cdot \frac{1}{32} \sum_{n \in \mathrm{batch}} \frac{\partial L_n}{\partial w}"/>
    </Stack>
    <Label class="h-p" text="{tr help.batches.p2}"/>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="32"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.batches.legend3}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="L_n"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.batches.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="epoch"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.batches.legend5}"/>
        </Stack>
    </Stack>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.batches.note6}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.batches.q7}"/>
            <Label class="h-a" text="{tr help.batches.a8}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.batches.try}" command="{binding tryIt}"/>
</Stack>
