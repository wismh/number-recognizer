<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.gradient.kicker}"/>
    <Label class="h-title" text="{tr help.gradient.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.gradient.p1}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-250" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.gradient.fig2}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="w \leftarrow w - \eta \, \frac{\partial L}{\partial w}"/>
        <Math class="h-math" display="true" formula="b \leftarrow b - \eta \, \frac{\partial L}{\partial b}"/>
    </Stack>
    <Label class="h-p" text="{tr help.gradient.p3}"/>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\eta"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.gradient.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\frac{\partial L}{\partial w}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.gradient.legend5}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\leftarrow"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.gradient.legend6}"/>
        </Stack>
    </Stack>
    <Label class="h-p" text="{tr help.gradient.p7}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="\frac{\partial L}{\partial w_{ki}} = (p_k - t_k) \, x_i, \qquad \frac{\partial L}{\partial b_k} = p_k - t_k"/>
    </Stack>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.gradient.note8}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.gradient.q9}"/>
            <Label class="h-a" text="{tr help.gradient.a10}"/>
        </Stack>
    </Stack>
</Stack>
