<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.image.kicker}"/>
    <Label class="h-title" text="{tr help.image.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.image.p1}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-220" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.image.fig2}"/>
    </Stack>
    <Label class="h-p" text="{tr help.image.p3}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="x_i = \frac{\mathrm{pixel}_i}{255}, \qquad i = 1, 2, \ldots, 784"/>
        <Math class="h-math" display="true" formula="28 \cdot 28 = 784"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="x_i"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.image.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="784"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.image.legend5}"/>
        </Stack>
    </Stack>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.image.note6}"/>
    </Stack>
    <Button class="h-try" content="{tr help.image.try}" command="{binding tryIt}"/>
</Stack>
