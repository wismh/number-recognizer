<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.dot.kicker}"/>
    <Label class="h-title" text="{tr help.dot.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.dot.p1}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="y = w_1 x_1 + w_2 x_2 + \cdots + w_{784} \, x_{784} + b"/>
        <Math class="h-math" display="true" formula="y = \sum_{i=1}^{784} w_i \, x_i + b"/>
    </Stack>
    <Label class="h-p" text="{tr help.dot.p2}"/>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\sum"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.dot.legend3}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="w_i"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.dot.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="x_i"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.dot.legend5}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="b"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.dot.legend6}"/>
        </Stack>
    </Stack>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.dot.note7}"/>
        <Math class="h-note-math" formula="y = \vec{w} \cdot \vec{x} + b"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.dot.q8}"/>
            <Label class="h-a" text="{tr help.dot.a9}"/>
        </Stack>
    </Stack>
</Stack>
