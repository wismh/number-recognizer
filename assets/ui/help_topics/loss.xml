<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.loss.kicker}"/>
    <Label class="h-title" text="{tr help.loss.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.loss.p1}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-220" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.loss.fig2}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="L = -\ln p_y"/>
        <Math class="h-math" display="true" formula="L_{\mathrm{mean}} = \frac{1}{N} \sum_{n=1}^{N} \left( -\ln p^{(n)}_{y_n} \right)"/>
    </Stack>
    <Label class="h-p" text="{tr help.loss.p3}"/>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="L"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.loss.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\ln"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.loss.legend5}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="p_y"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.loss.legend6}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="N"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.loss.legend7}"/>
        </Stack>
    </Stack>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.loss.note8}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.loss.q9}"/>
            <Label class="h-a" text="{tr help.loss.a10}"/>
        </Stack>
    </Stack>
</Stack>
