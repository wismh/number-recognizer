<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.ideal.kicker}"/>
    <Label class="h-title" text="{tr help.ideal.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.ideal.p1}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="x \leftarrow x - \eta&#x27; \, \frac{\partial L_k}{\partial x}, \qquad L_k = -\ln p_k(x)"/>
    </Stack>
    <Label class="h-p" text="{tr help.ideal.p2}"/>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="L_k"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.ideal.legend3}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\frac{\partial L_k}{\partial x}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.ideal.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\eta&#x27;"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.ideal.legend5}"/>
        </Stack>
    </Stack>
    <Label class="h-p" text="{tr help.ideal.p6}"/>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.ideal.note7}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.ideal.q8}"/>
            <Label class="h-a" text="{tr help.ideal.a9}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.ideal.try}" command="{binding tryIt}"/>
</Stack>
