<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.datasets.kicker}"/>
    <Label class="h-title" text="{tr help.datasets.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.datasets.p1}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-220" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.datasets.fig2}"/>
    </Stack>
    <Label class="h-p" text="{tr help.datasets.p3}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="x_c = \frac{\sum_i x_i \, I_i}{\sum_i I_i}, \qquad y_c = \frac{\sum_i y_i \, I_i}{\sum_i I_i}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="I_i"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.datasets.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="x_i,\; y_i"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.datasets.legend5}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="x_c,\; y_c"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.datasets.legend6}"/>
        </Stack>
    </Stack>
    <Label class="h-p" text="{tr help.datasets.p7}"/>
    <Label class="h-p" text="{tr help.datasets.p8}"/>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.datasets.q9}"/>
            <Label class="h-a" text="{tr help.datasets.a10}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.datasets.try}" command="{binding tryIt}"/>
</Stack>
