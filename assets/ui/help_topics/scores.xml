<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.scores.kicker}"/>
    <Label class="h-title" text="{tr help.scores.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.scores.p1}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-230" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.scores.fig2}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="s_k = \sum_{i=1}^{784} w_{ki} \, x_i + b_k, \qquad k = 0, 1, \ldots, 9"/>
        <Math class="h-math" display="true" formula="y_{\mathrm{pred}} = \operatorname{argmax}_k \, s_k"/>
    </Stack>
    <Label class="h-p" text="{tr help.scores.p3}"/>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="s_k"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.scores.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="w_{ki}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.scores.legend5}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="b_k"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.scores.legend6}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="y_{\mathrm{pred}}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.scores.legend7}"/>
        </Stack>
    </Stack>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.scores.note8}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.scores.q9}"/>
            <Label class="h-a" text="{tr help.scores.a10}"/>
        </Stack>
    </Stack>
</Stack>
