<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.backprop.kicker}"/>
    <Label class="h-title" text="{tr help.backprop.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.backprop.p1}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="\delta^{\mathrm{out}}_k = p_k - t_k"/>
        <Math class="h-math" display="true" formula="\delta_j = \left( \sum_k w^{(2)}_{kj} \, \delta^{\mathrm{out}}_k \right) \cdot [\, h_j &gt; 0 \,]"/>
        <Math class="h-math" display="true" formula="\frac{\partial L}{\partial w^{(2)}_{kj}} = \delta^{\mathrm{out}}_k \, h_j, \qquad \frac{\partial L}{\partial w^{(1)}_{ji}} = \delta_j \, x_i"/>
    </Stack>
    <Label class="h-p" text="{tr help.backprop.p2}"/>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\delta"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.backprop.legend3}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="[\, h_j &gt; 0 \,]"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.backprop.legend4}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="t_k"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.backprop.legend5}"/>
        </Stack>
    </Stack>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.backprop.note6}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.backprop.q7}"/>
            <Label class="h-a" text="{tr help.backprop.a8}"/>
        </Stack>
    </Stack>
</Stack>
